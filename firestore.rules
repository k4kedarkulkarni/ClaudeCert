rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Questions: public read, admin write (authenticated)
    match /questions/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Config: public read (needed for PDF URL + question count), admin write
    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
